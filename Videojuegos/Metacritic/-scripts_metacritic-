# FUNCIONES AUXILIARES

def normalizar(texto):
    texto = html.unescape(str(texto or ""))
    texto = unicodedata.normalize("NFKD", texto)
    texto = "".join(c for c in texto if not unicodedata.combining(c))
    texto = texto.lower()
    texto = re.sub(r"[^a-z0-9]+", " ", texto)
    return " ".join(texto.split())


def variantes_busqueda(titulo):
    variantes = [titulo]

    if ":" in titulo:
        variantes.append(titulo.split(":", 1)[0].strip())
        variantes.append(titulo.split(":", 1)[1].strip())

    # Variantes específicas comprobadas
    especiales = {
        "Metal Gear Solid V: The Phantom Pain": ["Metal Gear Solid V"],
        "The Legend of Zelda: Skyward Sword": ["Skyward Sword"],
        "Skies of Arcadia": ["Arcadia"],
        "Super Mario Galaxy 2": ["Mario Galaxy 2"]}

    variantes.extend(especiales.get(titulo, []))

    # Eliminar duplicados conservando el orden
    return list(dict.fromkeys(v for v in variantes if v))


def buscar_resultados(busqueda):
    url = (
        "https://backend.metacritic.com/finder/metacritic/"
        f"search/{quote_plus(busqueda)}/web"
        "?offset=0&limit=30"
        "&sortBy=META_SCORE&sortDirection=DESC"
        "&mcoTypeId=13"
        "&componentName=search"
        "&componentType=SearchResult"
        f"&apiKey={API_KEY}")

    respuesta = requests.get(url, headers=HEADERS, timeout=30)
    respuesta.raise_for_status()
    datos = respuesta.json()

    return datos.get("data", {}).get("items", [])


def coincidencia_exacta(titulo, resultados):
    objetivo = normalizar(titulo)

    for juego in resultados:
        titulo_api = normalizar(juego.get("title", ""))
        titulo_base = re.sub(r"\s+\d{4}$", "", titulo_api)

        if titulo_api == objetivo or titulo_base == objetivo:
            return juego

    return None


def encontrar_juego(titulo, anio):
    primer_resultado = None

    for busqueda in variantes_busqueda(titulo):
        try:
            resultados = buscar_resultados(busqueda)

            if resultados:
                if primer_resultado is None:
                    primer_resultado = resultados[0]

                exacto = coincidencia_exacta(titulo, resultados)

                if exacto:
                    return exacto

        except Exception as e:
            print(f"Error buscando '{busqueda}': {e}")

        time.sleep(0.5)

    return primer_resultado


# EXTRAER INFORMACIÓN DE LA FICHA DEL VIDEOJUEGO

def extraer_datos(slug, titulo_original, anio_original):
    url = f"https://www.metacritic.com/game/{slug}/"
    driver.get(url)
    time.sleep(2)

    try:
        texto = driver.find_element(By.TAG_NAME, "body").text

        metascore = re.search(
            r"METASCORE\s+.*?Based on \d+ Critic Reviews\s+(\d+)",
            texto,
            re.DOTALL)

        userscore = re.search(
            r"USER SCORE\s+.*?Based on [\d,]+ User Ratings\s+([\d.]+)",
            texto,
            re.DOTALL)

        if not metascore and not userscore:
            print(f"No se encontraron puntuaciones para {titulo_original}")
            return None

        return {
            "titulo": titulo_original,
            "anio": anio_original,
            "metascore": metascore.group(1) if metascore else None,
            "userscore": userscore.group(1) if userscore else None,
            "plataformas": [],
            "generos": [],
            "desarrolladores": []}

    except Exception as e:
        print(f"Error extrayendo datos de {titulo_original}: {e}")
        return None


